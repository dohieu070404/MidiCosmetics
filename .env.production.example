# Midi Cosmetics production/Vercel notes.
# For Vercel, set these values in Vercel Project Settings, not in frontend source.
NODE_ENV=production
APP_NAME=Midi Cosmetics API
API_PREFIX=/api/v1
PORT=8080

# Backend Prisma/Supabase PostgreSQL.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

JWT_ACCESS_SECRET=CHANGE_ME_RANDOM_ACCESS_SECRET_AT_LEAST_48_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_RANDOM_REFRESH_SECRET_AT_LEAST_48_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

CORS_ORIGIN=https://<FRONTEND_DOMAIN>.vercel.app,https://<CUSTOM_FRONTEND_DOMAIN_IF_ANY>
FRONTEND_URL=https://<FRONTEND_DOMAIN>.vercel.app
MESSENGER_URL=https://m.me/<FACEBOOK_PAGE_ID>
QUOTE_EXPIRY_DAYS=7
QUOTE_CAPTCHA_ENABLED=true
RECAPTCHA_SECRET_KEY=<GOOGLE_RECAPTCHA_SECRET_KEY>
RECAPTCHA_ALLOWED_HOSTNAMES=<FRONTEND_DOMAIN>.vercel.app,<CUSTOM_FRONTEND_DOMAIN_IF_ANY>
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
LOG_LEVEL=info
LOGGER_PRETTY=false
TRUST_PROXY=1

RUN_MIGRATIONS=false
DATABASE_SYNC_STRATEGY=none
SEED_DATABASE=false
AUTO_RESET_FAILED_MIGRATIONS=false
# The real admin already exists in Supabase, so bootstrap remains disabled.
ADMIN_ALLOWED_EMAILS=
ADMIN_BOOTSTRAP_TOKEN=
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_LOGIN_PATH=/quan-tri-midi-secure-2026

UPLOAD_DRIVER=cloudinary
UPLOAD_MAX_FILE_SIZE_MB=5
UPLOAD_IMAGE_MAX_FILE_SIZE_MB=5
UPLOAD_SPREADSHEET_MAX_FILE_SIZE_MB=10
UPLOAD_DIR=/tmp/midi-uploads
PRIVATE_UPLOAD_DIR=/tmp/midi-private-imports
PUBLIC_UPLOAD_BASE_URL=
CLOUDINARY_CLOUD_NAME=<CLOUDINARY_CLOUD_NAME>
CLOUDINARY_API_KEY=<CLOUDINARY_API_KEY>
CLOUDINARY_API_SECRET=<CLOUDINARY_API_SECRET>

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
ADMIN_ALERT_EMAIL=

# Frontend Vercel env must contain only VITE_* values.
VITE_APP_NAME=Midi Cosmetics
VITE_API_BASE_URL=https://<BACKEND_DOMAIN>.vercel.app/api/v1
VITE_API_ORIGIN=https://<BACKEND_DOMAIN>.vercel.app
VITE_ENABLE_API_MOCKING=false
VITE_ADMIN_LOGIN_PATH=/quan-tri-midi-secure-2026
VITE_MESSENGER_URL=https://m.me/<FACEBOOK_PAGE_ID>
VITE_QUOTE_CAPTCHA_ENABLED=true
VITE_RECAPTCHA_SITE_KEY=<GOOGLE_RECAPTCHA_SITE_KEY>
