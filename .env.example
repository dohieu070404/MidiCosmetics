# Do not put real credentials in this tracked file.
#
# Local Docker:
#   Windows:       powershell -ExecutionPolicy Bypass -File scripts/setup-local.ps1
#   macOS/Linux:   ./scripts/setup-local.sh
#
# Those scripts create the ignored file .env.docker.local with random local-only
# credentials. Production values belong in the hosting provider's secret manager.

# Public, frontend-safe production examples only:
VITE_APP_NAME=Midi Cosmetics
VITE_API_BASE_URL=https://<BACKEND_DOMAIN>/api/v1
VITE_API_ORIGIN=https://<BACKEND_DOMAIN>
VITE_ENABLE_API_MOCKING=false
VITE_ADMIN_LOGIN_PATH=/quan-tri-midi-secure-2026
VITE_MESSENGER_URL=https://m.me/<FACEBOOK_PAGE_ID>
VITE_QUOTE_CAPTCHA_ENABLED=true
VITE_RECAPTCHA_SITE_KEY=<PUBLIC_RECAPTCHA_SITE_KEY>
