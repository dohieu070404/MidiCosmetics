NODE_ENV=development
PORT=8080
APP_NAME=Midi Cosmetics API
API_PREFIX=/api/v1

# Required. Use a local PostgreSQL URL here or configure Supabase only in the
# deploy provider. Passwords must be URL-encoded when embedded in a URL.
DATABASE_URL=postgresql://<USER>:<URL_ENCODED_PASSWORD>@localhost:5432/<DATABASE>?schema=public
DIRECT_URL=postgresql://<USER>:<URL_ENCODED_PASSWORD>@localhost:5432/<DATABASE>?schema=public

# Required, distinct random strings. Production enforces at least 48 characters.
JWT_ACCESS_SECRET=<GENERATE_A_RANDOM_SECRET>
JWT_REFRESH_SECRET=<GENERATE_A_DIFFERENT_RANDOM_SECRET>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

CORS_ORIGIN=http://localhost:5173,http://localhost:8081
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
LOG_LEVEL=debug
LOGGER_PRETTY=true
TRUST_PROXY=false

# No sample admin account is created by seed. Keep bootstrap disabled because
# the real admin already exists in Supabase.
ADMIN_ALLOWED_EMAILS=
ADMIN_BOOTSTRAP_TOKEN=
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_LOGIN_PATH=/quan-tri-midi-secure-2026
FRONTEND_URL=http://localhost:5173
MESSENGER_URL=https://m.me/<FACEBOOK_PAGE_ID>
QUOTE_EXPIRY_DAYS=7
QUOTE_CAPTCHA_ENABLED=false
RECAPTCHA_SECRET_KEY=
RECAPTCHA_ALLOWED_HOSTNAMES=localhost,127.0.0.1

RUN_MIGRATIONS=true
DATABASE_SYNC_STRATEGY=migrate
SEED_DATABASE=true
AUTO_RESET_FAILED_MIGRATIONS=false

UPLOAD_DRIVER=local
UPLOAD_MAX_FILE_SIZE_MB=5
UPLOAD_IMAGE_MAX_FILE_SIZE_MB=5
UPLOAD_SPREADSHEET_MAX_FILE_SIZE_MB=10
UPLOAD_DIR=uploads
PRIVATE_UPLOAD_DIR=.private/imports
PUBLIC_UPLOAD_BASE_URL=http://localhost:8080
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
ADMIN_ALERT_EMAIL=
