{
  "name": "midi-cosmetics-backend",
  "version": "1.0.0",
  "description": "Production-ready ExpressJS backend foundation for Midi Cosmetics luxury beauty blog and product catalog.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:status": "prisma migrate status",
    "prisma:studio": "prisma studio",
    "prisma:seed": "node prisma/seed.js",
    "db:push": "prisma db push",
    "format": "prettier --write \"src/**/*.js\" \"prisma/**/*.js\" \"*.json\"",
    "format:check": "prettier --check \"src/**/*.js\" \"prisma/**/*.js\" \"*.json\"",
    "check:syntax": "find src prisma -type f -name '*.js' -print0 | xargs -0 -n1 node --check",
    "health": "node src/scripts/healthcheck.js"
  },
  "dependencies": {
    "@prisma/client": "7.9.1",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.5.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "2.2.0",
    "nodemailer": "9.0.5",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.0.0",
    "prisma": "7.9.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "prettier": "^3.9.0"
  },
  "overrides": {
    "body-parser": "1.20.6",
    "deepmerge-ts": "8.0.0",
    "qs": "6.15.2"
  },
  "engines": {
    "node": "24.x"
  }
}
