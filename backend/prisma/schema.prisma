generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum CommentStatus {
  VISIBLE
  HIDDEN
  SPAM
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum MediaProvider {
  LOCAL
  CLOUDINARY
}

enum SettingType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

enum QuoteStatus {
  CREATED
  MESSENGER_OPENED
  PROCESSED
  EXPIRED
}

enum InterestEventType {
  PRODUCT_VIEWED
  ADDED_TO_CART
  REMOVED_FROM_CART
  QUANTITY_CHANGED
  INCLUDED_IN_QUOTE
  QUOTE_CREATED
  MESSENGER_CLICKED
}

model User {
  id                BigInt     @id @default(autoincrement()) @map("id")
  uuid              String     @unique @default(uuid()) @map("uuid") @db.Char(36)
  email             String     @unique @map("email") @db.VarChar(191)
  passwordHash      String     @map("password_hash") @db.VarChar(255)
  fullName          String     @map("full_name") @db.VarChar(150)
  phone             String?    @map("phone") @db.VarChar(30)
  avatarUrl         String?    @map("avatar_url") @db.VarChar(500)
  role              UserRole   @default(USER) @map("role")
  status            UserStatus @default(ACTIVE) @map("status")
  emailVerifiedAt   DateTime?  @map("email_verified_at")
  passwordChangedAt DateTime?  @map("password_changed_at")
  lastLoginAt       DateTime?  @map("last_login_at")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  deletedAt         DateTime?  @map("deleted_at")

  refreshTokens           RefreshToken[]
  adminVerificationTokens AdminVerificationToken[]
  posts                   BlogPost[]
  blogLikes               BlogLike[]
  comments                Comment[]
  importJobs              ImportJob[]
  mediaAssets             MediaAsset[]
  auditLogs               AuditLog[]

  @@index([role], map: "idx_users_role")
  @@index([status], map: "idx_users_status")
  @@index([deletedAt], map: "idx_users_deleted_at")
  @@index([createdAt], map: "idx_users_created_at")
  @@map("users")
}

model RefreshToken {
  id        BigInt    @id @default(autoincrement()) @map("id")
  uuid      String    @unique @map("uuid") @db.Char(36)
  userId    BigInt    @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  userAgent String?   @map("user_agent") @db.VarChar(500)
  ipAddress String?   @map("ip_address") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_refresh_tokens_user_id")
  @@index([expiresAt], map: "idx_refresh_tokens_expires_at")
  @@index([revokedAt], map: "idx_refresh_tokens_revoked_at")
  @@map("refresh_tokens")
}

model AdminVerificationToken {
  id                  BigInt    @id @default(autoincrement()) @map("id")
  uuid                String    @unique @default(uuid()) @map("uuid") @db.Char(36)
  adminId             BigInt    @map("admin_id")
  type                String    @map("type") @db.VarChar(80)
  tokenHash           String    @unique @map("token_hash") @db.Char(64)
  pendingPasswordHash String?   @map("pending_password_hash") @db.VarChar(255)
  targetEmail         String?   @map("target_email") @db.VarChar(191)
  expiresAt           DateTime  @map("expires_at")
  usedAt              DateTime? @map("used_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, type], map: "idx_admin_verification_tokens_admin_type")
  @@index([expiresAt], map: "idx_admin_verification_tokens_expires_at")
  @@index([usedAt], map: "idx_admin_verification_tokens_used_at")
  @@map("admin_verification_tokens")
}

model NotificationRecipient {
  id         BigInt    @id @default(autoincrement()) @map("id")
  uuid       String    @unique @default(uuid()) @map("uuid") @db.Char(36)
  email      String    @unique @map("email") @db.VarChar(191)
  isVerified Boolean   @default(false) @map("is_verified")
  verifiedAt DateTime? @map("verified_at")
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  @@index([isVerified, isActive], map: "idx_notification_recipients_verified_active")
  @@index([deletedAt], map: "idx_notification_recipients_deleted_at")
  @@map("notification_recipients")
}

model EmailLog {
  id           BigInt   @id @default(autoincrement()) @map("id")
  uuid         String   @unique @default(uuid()) @map("uuid") @db.Char(36)
  type         String   @map("type") @db.VarChar(100)
  to           String   @map("to_email") @db.VarChar(191)
  subject      String   @map("subject") @db.VarChar(255)
  status       String   @map("status") @db.VarChar(40)
  errorMessage String?  @map("error_message") @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([type], map: "idx_email_logs_type")
  @@index([status], map: "idx_email_logs_status")
  @@index([createdAt], map: "idx_email_logs_created_at")
  @@map("email_logs")
}

model MediaAsset {
  id           BigInt        @id @default(autoincrement()) @map("id")
  uuid         String        @unique @default(uuid()) @map("uuid") @db.Char(36)
  uploaderId   BigInt?       @map("uploader_id")
  provider     MediaProvider @default(LOCAL) @map("provider")
  publicId     String?       @map("public_id") @db.VarChar(255)
  originalName String        @map("original_name") @db.VarChar(255)
  fileName     String?       @map("file_name") @db.VarChar(255)
  mimeType     String        @map("mime_type") @db.VarChar(100)
  sizeBytes    BigInt        @map("size_bytes")
  width        Int?          @map("width")
  height       Int?          @map("height")
  secureUrl    String        @map("secure_url") @db.VarChar(1000)
  altText      String?       @map("alt_text") @db.VarChar(255)
  metadata     Json?         @map("metadata")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")

  uploader      User?          @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  featuredPosts BlogPost[]     @relation("PostFeaturedImage")
  productImages ProductImage[]

  @@index([uploaderId], map: "idx_media_assets_uploader_id")
  @@index([provider], map: "idx_media_assets_provider")
  @@index([deletedAt], map: "idx_media_assets_deleted_at")
  @@map("media_assets")
}

model BlogCategory {
  id          BigInt    @id @default(autoincrement()) @map("id")
  uuid        String    @unique @default(uuid()) @map("uuid") @db.Char(36)
  parentId    BigInt?   @map("parent_id")
  name        String    @map("name") @db.VarChar(150)
  slug        String    @unique @map("slug") @db.VarChar(191)
  description String?   @map("description") @db.Text
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  parent   BlogCategory?  @relation("BlogCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children BlogCategory[] @relation("BlogCategoryTree")
  posts    BlogPost[]

  @@index([parentId], map: "idx_blog_categories_parent_id")
  @@index([sortOrder], map: "idx_blog_categories_sort_order")
  @@index([deletedAt], map: "idx_blog_categories_deleted_at")
  @@map("blog_categories")
}

model BlogTag {
  id        BigInt    @id @default(autoincrement()) @map("id")
  uuid      String    @unique @default(uuid()) @map("uuid") @db.Char(36)
  name      String    @map("name") @db.VarChar(100)
  slug      String    @unique @map("slug") @db.VarChar(191)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  posts BlogPostTag[]

  @@index([deletedAt], map: "idx_blog_tags_deleted_at")
  @@map("blog_tags")
}

model BlogPost {
  id              BigInt     @id @default(autoincrement()) @map("id")
  uuid            String     @unique @default(uuid()) @map("uuid") @db.Char(36)
  authorId        BigInt     @map("author_id")
  categoryId      BigInt?    @map("category_id")
  featuredImageId BigInt?    @map("featured_image_id")
  title           String     @map("title") @db.VarChar(255)
  slug            String     @unique @map("slug") @db.VarChar(191)
  excerpt         String?    @map("excerpt") @db.VarChar(500)
  content         String     @map("content") @db.Text
  status          PostStatus @default(DRAFT) @map("status")
  isFeatured      Boolean    @default(false) @map("is_featured")
  featuredOrder   Int        @default(0) @map("featured_order")
  readingMinutes  Int        @default(1) @map("reading_minutes")
  viewCount       Int        @default(0) @map("view_count")
  seoTitle        String?    @map("seo_title") @db.VarChar(255)
  seoDescription  String?    @map("seo_description") @db.VarChar(500)
  publishedAt     DateTime?  @map("published_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at")

  author        User          @relation(fields: [authorId], references: [id], onDelete: Restrict)
  category      BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  featuredImage MediaAsset?   @relation("PostFeaturedImage", fields: [featuredImageId], references: [id], onDelete: SetNull)
  tags          BlogPostTag[]
  comments      Comment[]
  likes         BlogLike[]

  @@index([authorId], map: "idx_blog_posts_author_id")
  @@index([categoryId], map: "idx_blog_posts_category_id")
  @@index([featuredImageId], map: "idx_blog_posts_featured_image_id")
  @@index([status, publishedAt], map: "idx_blog_posts_status_published_at")
  @@index([isFeatured, featuredOrder], map: "idx_blog_posts_featured_order")
  @@index([deletedAt], map: "idx_blog_posts_deleted_at")
  @@map("blog_posts")
}

model BlogLike {
  id        BigInt   @id @default(autoincrement()) @map("id")
  uuid      String   @unique @default(uuid()) @map("uuid") @db.Char(36)
  postId    BigInt   @map("post_id")
  userId    BigInt?  @map("user_id")
  ipHash    String?  @map("ip_hash") @db.Char(64)
  createdAt DateTime @default(now()) @map("created_at")

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([postId, userId], map: "uq_blog_likes_post_user")
  @@unique([postId, ipHash], map: "uq_blog_likes_post_ip")
  @@index([postId], map: "idx_blog_likes_post_id")
  @@index([userId], map: "idx_blog_likes_user_id")
  @@map("blog_likes")
}

model BlogPostTag {
  postId    BigInt   @map("post_id")
  tagId     BigInt   @map("tag_id")
  createdAt DateTime @default(now()) @map("created_at")

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId], map: "idx_blog_post_tags_tag_id")
  @@map("blog_post_tags")
}

model ProductBrand {
  id          BigInt    @id @default(autoincrement()) @map("id")
  uuid        String    @unique @default(uuid()) @map("uuid") @db.Char(36)
  name        String    @map("name") @db.VarChar(150)
  slug        String    @unique @map("slug") @db.VarChar(191)
  description String?   @map("description") @db.Text
  logoUrl     String?   @map("logo_url") @db.VarChar(1000)
  country     String?   @map("country") @db.VarChar(100)
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  products Product[]

  @@index([sortOrder], map: "idx_product_brands_sort_order")
  @@index([deletedAt], map: "idx_product_brands_deleted_at")
  @@map("product_brands")
}

model ProductCategory {
  id          BigInt    @id @default(autoincrement()) @map("id")
  uuid        String    @unique @default(uuid()) @map("uuid") @db.Char(36)
  parentId    BigInt?   @map("parent_id")
  name        String    @map("name") @db.VarChar(150)
  slug        String    @unique @map("slug") @db.VarChar(191)
  description String?   @map("description") @db.Text
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  parent   ProductCategory?  @relation("ProductCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children ProductCategory[] @relation("ProductCategoryTree")
  products Product[]

  @@index([parentId], map: "idx_product_categories_parent_id")
  @@index([sortOrder], map: "idx_product_categories_sort_order")
  @@index([deletedAt], map: "idx_product_categories_deleted_at")
  @@map("product_categories")
}

model ProductCollection {
  id             BigInt    @id @default(autoincrement()) @map("id")
  uuid           String    @unique @default(uuid()) @map("uuid") @db.Char(36)
  name           String    @map("name") @db.VarChar(150)
  slug           String    @unique @map("slug") @db.VarChar(191)
  description    String?   @map("description") @db.Text
  coverImageUrl  String?   @map("cover_image_url") @db.VarChar(1000)
  seoTitle       String?   @map("seo_title") @db.VarChar(255)
  seoDescription String?   @map("seo_description") @db.VarChar(500)
  isActive       Boolean   @default(true) @map("is_active")
  sortOrder      Int       @default(0) @map("sort_order")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  products ProductCollectionItem[]

  @@index([isActive, sortOrder], map: "idx_product_collections_active_sort_order")
  @@index([deletedAt], map: "idx_product_collections_deleted_at")
  @@map("product_collections")
}

model Product {
  id               BigInt        @id @default(autoincrement()) @map("id")
  uuid             String        @unique @default(uuid()) @map("uuid") @db.Char(36)
  categoryId       BigInt?       @map("category_id")
  brandId          BigInt?       @map("brand_id")
  name             String        @map("name") @db.VarChar(255)
  slug             String        @unique @map("slug") @db.VarChar(191)
  sku              String?       @unique @map("sku") @db.VarChar(100)
  barcode          String?       @map("barcode") @db.VarChar(100)
  shortDescription String?       @map("short_description") @db.VarChar(500)
  description      String?       @map("description") @db.Text
  skinType         String?       @map("skin_type") @db.VarChar(120)
  ingredients      String?       @map("ingredients") @db.Text
  howToUse         String?       @map("how_to_use") @db.Text
  benefits         String?       @map("benefits") @db.Text
  caution          String?       @map("caution") @db.Text
  price            Decimal       @default(0) @map("price") @db.Decimal(12, 2)
  stock            Int           @default(0) @map("stock")
  unit             String?       @map("unit") @db.VarChar(50)
  compareAtPrice   Decimal?      @map("compare_at_price") @db.Decimal(12, 2)
  currency         String        @default("VND") @map("currency") @db.Char(3)
  status           ProductStatus @default(DRAFT) @map("status")
  isFeatured       Boolean       @default(false) @map("is_featured")
  featuredOrder    Int           @default(0) @map("featured_order")
  viewCount        Int           @default(0) @map("view_count")
  sortOrder        Int           @default(0) @map("sort_order")
  seoTitle         String?       @map("seo_title") @db.VarChar(255)
  seoDescription   String?       @map("seo_description") @db.VarChar(500)
  publishedAt      DateTime?     @map("published_at")
  rawImportData    Json?         @map("raw_import_data")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  deletedAt        DateTime?     @map("deleted_at")

  category       ProductCategory?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand          ProductBrand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  images         ProductImage[]
  comments       Comment[]
  collections    ProductCollectionItem[]
  quoteItems     QuoteItem[]
  interestEvents InterestEvent[]

  @@index([categoryId], map: "idx_products_category_id")
  @@index([brandId], map: "idx_products_brand_id")
  @@index([barcode], map: "idx_products_barcode")
  @@index([stock], map: "idx_products_stock")
  @@index([status, publishedAt], map: "idx_products_status_published_at")
  @@index([isFeatured, featuredOrder], map: "idx_products_featured_order")
  @@index([skinType], map: "idx_products_skin_type")
  @@index([viewCount], map: "idx_products_view_count")
  @@index([deletedAt], map: "idx_products_deleted_at")
  @@map("products")
}

model Quote {
  id                    BigInt      @id @default(autoincrement()) @map("id")
  uuid                  String      @unique @default(uuid()) @map("uuid") @db.Char(36)
  code                  String      @unique @map("code") @db.VarChar(32)
  publicTokenHash       String      @unique @map("public_token_hash") @db.Char(64)
  publicTokenCiphertext String?     @map("public_token_ciphertext") @db.Text
  requestKey            String?     @unique @map("request_key") @db.Char(36)
  status                QuoteStatus @default(CREATED) @map("status")
  note                  String?     @map("note") @db.VarChar(1000)
  snapshotTotal         Decimal     @map("snapshot_total") @db.Decimal(12, 2)
  currency              String      @default("VND") @map("currency") @db.Char(3)
  messengerOpenedAt     DateTime?   @map("messenger_opened_at")
  processedAt           DateTime?   @map("processed_at")
  expiresAt             DateTime    @map("expires_at")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")
  archivedAt            DateTime?   @map("archived_at")

  items          QuoteItem[]
  interestEvents InterestEvent[]

  @@index([status, createdAt], map: "idx_quotes_status_created_at")
  @@index([expiresAt], map: "idx_quotes_expires_at")
  @@index([archivedAt], map: "idx_quotes_archived_at")
  @@map("quotes")
}

model QuoteItem {
  id          BigInt   @id @default(autoincrement()) @map("id")
  quoteId     BigInt   @map("quote_id")
  productId   BigInt?  @map("product_id")
  productUuid String   @map("product_uuid") @db.Char(36)
  name        String   @map("name") @db.VarChar(255)
  sku         String?  @map("sku") @db.VarChar(100)
  unit        String?  @map("unit") @db.VarChar(50)
  imageUrl    String?  @map("image_url") @db.VarChar(1000)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  quantity    Int      @map("quantity")
  lineTotal   Decimal  @map("line_total") @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  quote   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([quoteId], map: "idx_quote_items_quote_id")
  @@index([productId], map: "idx_quote_items_product_id")
  @@map("quote_items")
}

model InterestEvent {
  id          BigInt            @id @default(autoincrement()) @map("id")
  uuid        String            @unique @default(uuid()) @map("uuid") @db.Char(36)
  eventType   InterestEventType @map("event_type")
  productId   BigInt?           @map("product_id")
  quoteId     BigInt?           @map("quote_id")
  sessionHash String?           @map("session_hash") @db.Char(64)
  metadata    Json?             @map("metadata")
  createdAt   DateTime          @default(now()) @map("created_at")

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  quote   Quote?   @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt], map: "idx_interest_events_type_created_at")
  @@index([productId, createdAt], map: "idx_interest_events_product_created_at")
  @@index([quoteId], map: "idx_interest_events_quote_id")
  @@index([sessionHash, createdAt], map: "idx_interest_events_session_created_at")
  @@map("interest_events")
}

model ProductCollectionItem {
  collectionId BigInt   @map("collection_id")
  productId    BigInt   @map("product_id")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")

  collection ProductCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([productId], map: "idx_product_collection_items_product_id")
  @@map("product_collection_items")
}

model ProductImage {
  id           BigInt   @id @default(autoincrement()) @map("id")
  productId    BigInt   @map("product_id")
  mediaAssetId BigInt   @map("media_asset_id")
  altText      String?  @map("alt_text") @db.VarChar(255)
  sortOrder    Int      @default(0) @map("sort_order")
  isPrimary    Boolean  @default(false) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@unique([productId, mediaAssetId], map: "uq_product_images_product_media")
  @@index([productId, sortOrder], map: "idx_product_images_product_sort_order")
  @@index([mediaAssetId], map: "idx_product_images_media_asset_id")
  @@map("product_images")
}

model Comment {
  id          BigInt        @id @default(autoincrement()) @map("id")
  uuid        String        @unique @default(uuid()) @map("uuid") @db.Char(36)
  postId      BigInt?       @map("post_id")
  productId   BigInt?       @map("product_id")
  userId      BigInt?       @map("user_id")
  parentId    BigInt?       @map("parent_id")
  authorName  String        @map("author_name") @db.VarChar(150)
  authorEmail String        @map("author_email") @db.VarChar(191)
  content     String        @map("content") @db.Text
  status      CommentStatus @default(VISIBLE) @map("status")
  ipAddress   String?       @map("ip_address") @db.VarChar(64)
  userAgent   String?       @map("user_agent") @db.VarChar(500)
  moderatedAt DateTime?     @map("moderated_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  deletedAt   DateTime?     @map("deleted_at")

  post    BlogPost? @relation(fields: [postId], references: [id], onDelete: Cascade)
  product Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  @@index([postId, status], map: "idx_comments_post_status")
  @@index([productId, status], map: "idx_comments_product_status")
  @@index([userId], map: "idx_comments_user_id")
  @@index([parentId], map: "idx_comments_parent_id")
  @@index([status, createdAt], map: "idx_comments_status_created_at")
  @@index([deletedAt], map: "idx_comments_deleted_at")
  @@map("comments")
}

model ImportJob {
  id           BigInt       @id @default(autoincrement()) @map("id")
  uuid         String       @unique @default(uuid()) @map("uuid") @db.Char(36)
  createdById  BigInt?      @map("created_by_id")
  type         String       @map("type") @db.VarChar(100)
  originalName String       @map("original_name") @db.VarChar(255)
  fileUrl      String?      @map("file_url") @db.VarChar(1000)
  status       ImportStatus @default(PENDING) @map("status")
  totalRows    Int          @default(0) @map("total_rows")
  successRows  Int          @default(0) @map("success_rows")
  failedRows   Int          @default(0) @map("failed_rows")
  errorReport  Json?        @map("error_report")
  startedAt    DateTime?    @map("started_at")
  completedAt  DateTime?    @map("completed_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  deletedAt    DateTime?    @map("deleted_at")

  createdBy User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  rows      ImportRow[]

  @@index([createdById], map: "idx_import_jobs_created_by_id")
  @@index([type, status], map: "idx_import_jobs_type_status")
  @@index([deletedAt], map: "idx_import_jobs_deleted_at")
  @@map("import_jobs")
}

model ImportRow {
  id          BigInt   @id @default(autoincrement()) @map("id")
  uuid        String   @unique @default(uuid()) @map("uuid") @db.Char(36)
  importJobId BigInt   @map("import_job_id")
  rowNumber   Int      @map("row_number")
  sku         String?  @map("sku") @db.VarChar(100)
  status      String   @map("status") @db.VarChar(30)
  message     String?  @map("message") @db.Text
  warnings    Json?    @map("warnings")
  errors      Json?    @map("errors")
  rawData     Json?    @map("raw_data")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  importJob ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@unique([importJobId, rowNumber], map: "uq_import_rows_job_row")
  @@index([importJobId], map: "idx_import_rows_import_job_id")
  @@index([sku], map: "idx_import_rows_sku")
  @@index([status], map: "idx_import_rows_status")
  @@map("import_rows")
}

model SiteSetting {
  id          BigInt      @id @default(autoincrement()) @map("id")
  key         String      @unique @map("setting_key") @db.VarChar(120)
  value       Json        @map("setting_value")
  type        SettingType @default(STRING) @map("setting_type")
  group       String      @default("general") @map("setting_group") @db.VarChar(80)
  description String?     @map("description") @db.VarChar(255)
  isPublic    Boolean     @default(false) @map("is_public")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@index([group], map: "idx_site_settings_group")
  @@index([isPublic], map: "idx_site_settings_is_public")
  @@map("site_settings")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement()) @map("id")
  uuid       String   @unique @default(uuid()) @map("uuid") @db.Char(36)
  actorId    BigInt?  @map("actor_id")
  actorEmail String?  @map("actor_email") @db.VarChar(191)
  action     String   @map("action") @db.VarChar(120)
  entityType String   @map("entity_type") @db.VarChar(120)
  entityId   String?  @map("entity_id") @db.VarChar(120)
  beforeData Json?    @map("before_data")
  afterData  Json?    @map("after_data")
  metadata   Json?    @map("metadata")
  ipAddress  String?  @map("ip_address") @db.VarChar(64)
  userAgent  String?  @map("user_agent") @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId], map: "idx_audit_logs_actor_id")
  @@index([actorEmail], map: "idx_audit_logs_actor_email")
  @@index([entityType, entityId], map: "idx_audit_logs_entity")
  @@index([createdAt], map: "idx_audit_logs_created_at")
  @@map("audit_logs")
}
