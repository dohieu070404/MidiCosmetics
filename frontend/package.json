{
  "name": "midi-cosmetics-reactjs",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "ReactJS website tiếng Việt cho Midi Cosmetics với catalog, blog, guest cart, phiếu yêu cầu và khu vực quản trị riêng.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"*.{js,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"*.{js,json}\"",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "backend:dev": "npm --prefix backend run dev",
    "backend:prisma:generate": "npm --prefix backend run prisma:generate",
    "backend:prisma:migrate": "npm --prefix backend run prisma:migrate"
  },
  "dependencies": {
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "axios": "1.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.0",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "7.18.2",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "prettier": "^3.9.0",
    "tailwindcss": "^4.3.0",
    "vite": "^8.2.1"
  },
  "overrides": {
    "form-data": "4.0.6"
  },
  "engines": {
    "node": "24.x"
  }
}
